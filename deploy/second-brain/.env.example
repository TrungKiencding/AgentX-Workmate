# Copy to .env, fill in, and keep it off every machine that is not this one.
#
#   cp .env.example .env        # cp, not mv — this file has to stay
#   make kek                    # prints a fresh AGENTX_BRAIN_KEK
#
# .env is ignored by this directory's allowlist .gitignore. Do not "fix" that.
#
# Every variable the service reads is listed here. If you add one to
# second_brain/settings.py, add it here too — this file is the operator's
# only complete list, and `make config` validates the compose file against it.

# --- Database ---------------------------------------------------------------
# Read by the service. Inside compose the host is the `postgres` service.
#
# THE PASSWORD HERE IS PART OF A URL. `@ / : ? # [ ] %` and space must be
# percent-encoded, and getting it wrong does not look like a password problem:
# asyncpg splits the userinfo at the FIRST `@`, so a password containing one
# turns the rest of it into the hostname and the service dies with
#
#   could not reach Postgres: [Errno -2] Name or service not known
#
# which reads like a networking fault and sends you looking in the wrong place.
# `Kienlt@2026` has to be written `Kienlt%402026` here — and ONLY here; the
# POSTGRES_PASSWORD below is read literally and must stay unencoded.
#
# Sidestep the whole class of problem: `make pw` prints a password that needs
# no encoding.
AGENTX_BRAIN_DATABASE_URL=postgresql://brain:CHANGE_ME@postgres:5432/brain

# Used by the postgres container itself. Must be the SAME password as the one
# in the DSN above, but written plainly — Postgres reads this value literally,
# so percent-encoding it here would set a different password than the one the
# service then sends.
#
# Only read when the database is first created. Changing it later needs
# `docker compose down -v` (destroys the data) or an `ALTER USER` in psql.
POSTGRES_PASSWORD=CHANGE_ME

# --- Encryption -------------------------------------------------------------
# Wraps every stored model key (AES-256-GCM). 32 bytes, base64:
#   openssl rand -base64 32
#
# LOSING THIS LOSES EVERY STORED KEY. The rows stay, and nothing can open
# them; recovery is minting every person a new key. Back it up somewhere that
# is not this host, and not this repository.
#
# The placeholder is deliberately not empty and deliberately not valid: compose
# starts, and the service then refuses with a message that names the variable
# and prints the command that generates one.
AGENTX_BRAIN_KEK=REPLACE_ME_WITH_make_kek

# Names the KEK each row is written with, so the KEK can be rotated without
# downtime. Bump it when you roll the key; see "Rotating the KEK" in README.md.
AGENTX_BRAIN_KEK_ID=k1

# The KEK being retired, and the id the rows still wearing it carry. Empty
# except during a roll: set both, restart, and every row moves onto the new KEK
# the next time its owner asks for their key. Once none is left, empty them
# again. Setting one without the other is refused at startup — a retiring KEK
# with no id opens nothing, because rows name the KEK that wrapped them.
AGENTX_BRAIN_KEK_PREVIOUS=
AGENTX_BRAIN_KEK_PREVIOUS_ID=

# --- LiteLLM ----------------------------------------------------------------
# The proxy model keys are minted against, and the admin credential that mints
# them. Both are required: without them POST /v1/model-key answers 503 and
# nobody gets a key. This is the machine that holds the admin key now — it is
# no longer shipped inside the desktop installer.
AGENTX_BRAIN_LITELLM_BASE_URL=https://vtn-4000.wondertek.space
AGENTX_LITELLM_ADMIN_KEY=

# Prefix for the alias each person's key wears in the proxy's own console.
# Optional; defaults to the shipped `accounts.litellm.key_alias_prefix`, which
# is what every existing install already uses. Change it only when two fleets
# share one proxy and you need to tell their keys apart.
# AGENTX_BRAIN_KEY_ALIAS_PREFIX=agentx-workmate

# --- Identity ---------------------------------------------------------------
# The realm the service verifies bearers against. Same three values the
# desktop app signs in with — they must name the SAME realm, or the service
# will reject tokens the app considers perfectly valid.
AGENTX_DASHBOARD_KEYCLOAK_BASE_URL=https://agentx.astralx.com.vn/auth
AGENTX_DASHBOARD_KEYCLOAK_REALM=agent-hub
AGENTX_DASHBOARD_KEYCLOAK_CLIENT_ID=agentx-workmate

# --- Connection pool --------------------------------------------------------
# Optional. Defaults are 1 and 10, which is right for a few hundred devices.
# AGENTX_BRAIN_POOL_MIN=1
# AGENTX_BRAIN_POOL_MAX=10

# --- Change feed ------------------------------------------------------------
# Optional, all three.
#
# The largest body POST /v1/sync/push will read, in bytes. Default 8 MB, which
# is comfortably above one conversation and all of its messages. A device that
# is refused keeps its records queued and retries in smaller batches, so
# lowering this costs round trips and never data.
# AGENTX_BRAIN_MAX_PUSH_BYTES=8388608

# How long a delete is remembered before the tombstone is swept, in days.
# Default 90.
#
# A tombstone is what stops a device that was offline when something was
# deleted from pushing the row straight back. So this window has to outlast any
# plausible offline stretch — a laptop shut in a drawer for a season, not an
# afternoon. SHORTENING IT RESURRECTS DELETED CONVERSATIONS on every device the
# moment a long-offline machine reconnects. Lengthen rather than shorten.
# AGENTX_BRAIN_TOMBSTONE_RETENTION_DAYS=90

# How often the sweeper runs, in seconds. Default is daily. Exists mainly so a
# test can drive a sweep without waiting a day for one.
# AGENTX_BRAIN_TOMBSTONE_SWEEP_SECONDS=86400

# --- TLS --------------------------------------------------------------------
# The hostname Caddy gets a certificate for, and the address it publishes.
# Set to `localhost` for a local trial; Caddy then uses its internal CA
# instead of asking Let's Encrypt for a certificate it cannot get.
BRAIN_DOMAIN=brain.example.com

# The three below are ONLY for a host where something else already owns ports
# 80 and 443 — nginx, another Caddy, traefik, an ingress. Leave them empty
# otherwise: the defaults are the standalone setup above.
#
# Do not reach for these merely to move Caddy onto a spare TLS port. ACME
# HTTP-01 is answered on port 80 and TLS-ALPN-01 on 443 — Let's Encrypt's rule,
# not Caddy's — so Caddy on 8443 never receives a challenge and the certificate
# never arrives. A self-signed one does not rescue it either: the laptop client
# verifies TLS and will refuse it. Either the existing proxy terminates TLS
# (which is what these three are for), or you supply a real certificate and add
# a `tls <cert> <key>` line to the Caddyfile.
#
# To run behind an existing proxy, set:
#
#   BRAIN_SITE_ADDRESS=:80
#   BRAIN_HTTP_PUBLISH=127.0.0.1:8811
#
# then delete the HTTPS line from the caddy `ports:` list in
# docker-compose.yml, and point the existing proxy at http://127.0.0.1:8811.
# That proxy must pass WebSocket upgrades through and allow at least 120s of
# idle time, or /v1/sync/stream reconnects forever — see the Caddyfile.
#
# `:80` means plain HTTP inside the container: no certificate, no ACME.
BRAIN_SITE_ADDRESS=

# The host side of Caddy's port mapping. KEEP THE `127.0.0.1:` PREFIX. A bare
# `8811` publishes on every interface, which puts an endpoint that mints model
# keys on the network with no TLS in front of it.
BRAIN_HTTP_PUBLISH=
BRAIN_HTTPS_PUBLISH=
