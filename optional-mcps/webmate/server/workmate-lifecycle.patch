+test("lifecycle commands include busy inactive browsers, exclude developer installs, and retain receipts", async () => {
+  const dir = mkdtempSync(path.join(tmpdir(), "webmate-lifecycle-"));
+  const port = await freePort();
+  const commandsDir = path.join(dir, "commands");
+  const child = spawn(process.execPath, [path.join(packageDir, "dist/index.js")], {
+    env: { ...process.env, WEBMATE_DIR: dir, WEBMATE_BRIDGE_PORT: String(port), WEBMATE_PREPARE_UPDATE_TIMEOUT_MS: "100" },
+    stdio: ["pipe", "ignore", "pipe"],
+  });
+  let stderr = "";
+  child.stderr.on("data", chunk => { stderr += chunk.toString(); });
+  const state = () => { try { return JSON.parse(readFileSync(path.join(dir, "state.json"))); } catch { return null; } };
+  const sockets = [];
+  const seen = new Map();
+  const receipt = id => { try { return JSON.parse(readFileSync(path.join(commandsDir, "results", `${id}.json`))); } catch { return null; } };
+  try {
+    await until(() => state()?.listening);
+    for (const [instanceId, busy, installType] of [["busy", 2, "workmate"], ["idle", 0, "workmate"], ["dev", 0, "dev"]]) {
+      const ws = new WebSocket(`ws://127.0.0.1:${port}/extension`);
+      sockets.push(ws); seen.set(instanceId, []);
+      ws.on("open", () => ws.send(JSON.stringify({ type: "hello", client: "webbrain-extension", protocolVersion: 3, version: "1.0.11", installType, instanceId, signedIn: true })));
+      ws.on("message", raw => {
+        const message = JSON.parse(raw.toString());
+        if (!message.action) return;
+        seen.get(instanceId).push(message.action);
+        ws.send(JSON.stringify({ id: message.id, ok: true, result: { busy: message.payload.resume ? 0 : busy } }));
+      });
+      await until(() => state()?.connections?.some(c => c.instanceId === instanceId));
+    }
+    dropCommand(commandsDir, "drain-all", "prepare_update");
+    await until(() => receipt("drain-all"));
+    assert.equal(receipt("drain-all").ok, false);
+    assert.equal(receipt("drain-all").busy, 2);
+    assert.deepEqual(receipt("drain-all").results.map(r => r.instanceId).sort(), ["busy", "idle"]);
+    dropCommand(commandsDir, "resume-all", "resume");
+    dropCommand(commandsDir, "reload-all", "reload");
+    await until(() => receipt("reload-all"));
+    assert.equal(receipt("resume-all").ok, true);
+    assert.equal(receipt("reload-all").ok, true);
+    assert.ok(seen.get("busy").includes("workmate_reload"));
+    assert.ok(seen.get("idle").includes("workmate_reload"));
+    assert.deepEqual(seen.get("dev"), []);
+    assert.equal(receipt("drain-all").ok, false, "later outcomes cannot overwrite a drain receipt");
+    dropCommand(commandsDir, "only-idle", "reload", { instanceIds: ["idle"] });
+    await until(() => receipt("only-idle"));
+    assert.deepEqual(receipt("only-idle").results.map(r => r.instanceId), ["idle"]);
+  } catch (error) { error.message += `\n${stderr}`; throw error; }
+  finally {
+    sockets.forEach(ws => ws.terminate());
+    if (child.exitCode === null) { const exited = once(child, "exit"); child.stdin.end(); await exited; }
+    rmSync(dir, { recursive: true, force: true });
+  }
+});
